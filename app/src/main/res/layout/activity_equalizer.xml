<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_player"
    android:fitsSystemWindows="true">

    <!-- Header Bar -->
    <RelativeLayout
        android:id="@+id/eqHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnEqBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Go Back"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-medium"
            android:text="EQUALIZER &amp; FX"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:letterSpacing="0.1" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchEqEnable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:thumbTint="@color/white"
            app:trackTint="@color/primary_light" />
    </RelativeLayout>

    <!-- Scrollable Control Center -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/eqHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- Presets Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Presets"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:letterSpacing="0.05" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_glass_card">

                <Spinner
                    android:id="@+id/spinnerPresets"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="16dp"
                    android:spinnerMode="dropdown"
                    android:theme="@style/Theme.Cacun" />
            </FrameLayout>

            <!-- 5-Band Equalizer Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Frequency Bands"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:letterSpacing="0.05" />

            <LinearLayout
                android:id="@+id/cardBandsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <!-- Dynamically generated or placeholder bands list -->
                <!-- We will add 5 standard bands in XML for compile-time layout certainty -->
                <LinearLayout
                    android:id="@+id/eqBandsLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Band item template repeat -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:id="@+id/tvBand0Label"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="60 Hz"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"/>

                        <SeekBar
                            android:id="@+id/seekBarBand0"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="30"
                            android:progress="15"
                            android:progressTint="@color/primary_light"
                            android:thumbTint="@color/white"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:id="@+id/tvBand1Label"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="230 Hz"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"/>

                        <SeekBar
                            android:id="@+id/seekBarBand1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="30"
                            android:progress="15"
                            android:progressTint="@color/primary_light"
                            android:thumbTint="@color/white"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:id="@+id/tvBand2Label"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="910 Hz"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"/>

                        <SeekBar
                            android:id="@+id/seekBarBand2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="30"
                            android:progress="15"
                            android:progressTint="@color/primary_light"
                            android:thumbTint="@color/white"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:id="@+id/tvBand3Label"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="4 kHz"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"/>

                        <SeekBar
                            android:id="@+id/seekBarBand3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="30"
                            android:progress="15"
                            android:progressTint="@color/primary_light"
                            android:thumbTint="@color/white"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvBand4Label"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="14 kHz"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"/>

                        <SeekBar
                            android:id="@+id/seekBarBand4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="30"
                            android:progress="15"
                            android:progressTint="@color/primary_light"
                            android:thumbTint="@color/white"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Sound Effects (Bass Boost & Virtualizer) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Audio Effects"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:letterSpacing="0.05" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Bass Boost Slider -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bass Boost"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"/>

                <SeekBar
                    android:id="@+id/seekBarBassBoost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="20dp"
                    android:max="1000"
                    android:progress="0"
                    android:progressTint="@color/md_you_pastel_purple"
                    android:thumbTint="@color/white" />

                <!-- Virtualizer Slider -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3D Surround (Virtualizer)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"/>

                <SeekBar
                    android:id="@+id/seekBarVirtualizer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="1000"
                    android:progress="0"
                    android:progressTint="@color/md_you_pastel_indigo"
                    android:thumbTint="@color/white" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
