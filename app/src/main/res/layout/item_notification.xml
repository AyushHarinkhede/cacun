<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/bg_card"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Platform Badge -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_notif_logo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/txt_notif_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="DL"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Title and Message -->
        <LinearLayout
            android:id="@+id/layout_notif_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintStart_toEndOf="@id/card_notif_logo"
            app:layout_constraintEnd_toStartOf="@id/layout_notif_right"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/txt_notif_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Streak warning! 🦉"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_notif_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Don't lose your French streak today! Complete a quick 5-min lesson now."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Right Side: Unread dot and Time -->
        <LinearLayout
            android:id="@+id/layout_notif_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Unread Blue Dot -->
            <View
                android:id="@+id/view_notif_unread_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_unread_dot"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/txt_notif_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3m ago"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
